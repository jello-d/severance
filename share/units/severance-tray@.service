# Managed by severance (docs/enclave-user.md). A USER unit: the enclave's
# TRAY RELAY (libexec/severance-tray), in the enclave account's lingering
# user manager: it runs the enclave's private tray bus and relays its
# apps' StatusNotifier icons onto it, and nothing else of the enclave.
# The instance name is the enclave. Rendered by `severance enclave
# provision` into /etc/systemd/user, root-owned, enabled globally; the
# ExecCondition lets only the account whose SEVERANCE_ENCLAVE (its
# environment.d) names this instance run it.
[Unit]
Description=severance: the tray relay of enclave %i

[Service]
ExecCondition=/bin/sh -c 'test "$SEVERANCE_ENCLAVE" = "%i"'
ExecStart=@LIBEXEC@/severance-tray %i
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
