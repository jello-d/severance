#!/bin/sh
# severance-owned valet-key hook
#
# valet-key context hook -> severance. THE canonical copy: severance ships it,
# an integrator PLACES it (tackup symlinks it on a provisioned box; `severance
# install` copies it on a standalone one). One content, several placements, so
# a verb moving here cannot leave a stale copy behind somewhere else.
#
# valet-key and severance rendezvous at $VALET_KEY_CONFIG/context with nothing
# else in the loop. Pure delegation: it maps valet-key's two verbs onto
# severance's and holds no logic of its own, which is the point. It used to
# substitute a default token for empty output, because valet-key read an empty
# resolve as "no opinion" and severance prints nothing to mean "definitely not
# in an enclave". valet-key now reads exit 0 as the answer whether or not it
# printed, so there is nothing left here to drift.
#
# No severance: exit 0 saying nothing. valet-key then falls back to its own
# rule, which is exactly right -- there is no boundary on this box to report.
set -eu
command -v severance >/dev/null 2>&1 || exit 0
case "${1:-}" in
  resolve) exec severance current ;;
  guard)   shift; exec severance guard "$@" ;;
esac
exit 0
