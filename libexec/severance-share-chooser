#!/usr/bin/python3 -I
"""severance-share-chooser: pick which enclave screen or window to share.

The chooser an ENCLAVE's xdg-desktop-portal-wlr runs for screen sharing
(its config names this as a `dmenu` chooser). The portal writes one target
per line on stdin and takes the line printed on stdout as the choice;
printing nothing declines. The lines are

    Monitor: <output name> <description>
    Window: <title> (<identifier>) [<app id>]

where the `[<app id>]` part is wayfire-mods' xdpw-chooser-app-id patch: an
older backend omits it, and the row then shows the title with a generic
icon. The line printed back is ALWAYS the one received, unaltered, because
the portal matches it byte for byte against its own.

A SCREEN IS OFFERED ONLY WHEN THE COMPOSITOR CAN DRAW IT SAFELY, and that is
the portal's decision, not this chooser's: wayfire-mods gives an enclave a
screen source that draws only that enclave's windows, and the portal offers
monitors only when such a source exists. So a Monitor line is shown as it
comes; screens are listed first.

AN ORDINARY WINDOW, not an overlay: an enclave gets no layer-shell, so the
usual pickers (slurp, wofi) cannot run, and as a normal toplevel this window
carries the enclave's mark, which is how the person sees which side asks.
Its app id is APP_ID, fixed, so a compositor rule can key on it (an
integrator makes it sticky and always on top, for instance).
Each window row is the app's icon and its name, small and dim (from the
ENCLAVE's own desktop files), over the window's title, bold: the title is
what a person matches on, and the icon already says which app. A screen row
is a display icon, "Screen", and the monitor's description. The header takes
SEVERANCE_ENCLAVE_COLOR (any CSS colour) when set, else the theme's accent.
An unanswered prompt DECLINES after SEVERANCE_CHOOSER_TIMEOUT seconds
(default 120), rather than leaving the portal waiting forever.

`--candidates` prints the lines that would be offered, and `--rows` what
each row would show (`name<TAB>title<TAB>icon`), and both exit with no
display needed (for tests).
"""

import os
import re
import sys

APP_ID = "severance-share-chooser"
PREFIX = "Window: "
SCREEN = "Monitor: "
SCREEN_ICON = "video-display"
LINE = re.compile(r"^Window: (?P<title>.*) \((?P<ident>[^() ]*)\)"
                  r"(?: \[(?P<app>[^\]]*)\])?$")
FALLBACK_ICON = "application-x-executable"


def candidates(lines):
    """Screens first, then windows, each in the order the portal gave."""
    lines = [x.rstrip("\n") for x in lines]
    return ([ln for ln in lines if ln.startswith(SCREEN)] +
            [ln for ln in lines if ln.startswith(PREFIX)])


def parse(line):
    """(title, app id) of one candidate; either may be empty."""
    m = LINE.match(line)
    if not m:
        return line[len(PREFIX):], ""
    return m.group("title"), m.group("app") or ""


def app_info(app_id):
    """The enclave's desktop entry for an app id, or None.

    By file name first (google-chrome -> google-chrome.desktop, any case),
    then by StartupWMClass, which is how Electron apps (Slack: app id
    `Slack`, file slack.desktop) are found."""
    if not app_id:
        return None
    import gi
    from gi.repository import Gio
    try:        # GLib 2.86 moved it to GioUnix and deprecates the old name
        gi.require_version("GioUnix", "2.0")
        from gi.repository import GioUnix
        desktop = GioUnix.DesktopAppInfo
    except (ValueError, ImportError):
        desktop = Gio.DesktopAppInfo
    for name in (app_id, app_id.lower()):
        try:
            info = desktop.new(name + ".desktop")
        except TypeError:
            info = None
        if info is not None:
            return info
    want = app_id.lower()
    for info in Gio.AppInfo.get_all():
        wm = info.get_startup_wm_class() if hasattr(
            info, "get_startup_wm_class") else None
        if wm and wm.lower() == want:
            return info
    return None


def describe(line):
    """(name, title, icon) a row shows: icon is a GIcon string."""
    if line.startswith(SCREEN):
        name, _, desc = line[len(SCREEN):].partition(" ")
        return ("Screen", "%s (%s)" % (desc, name) if desc else name,
                SCREEN_ICON)
    title, app_id = parse(line)
    info = app_info(app_id)
    if info is not None:
        icon = info.get_icon()
        return (info.get_name() or app_id, title,
                icon.to_string() if icon else FALLBACK_ICON)
    return (app_id or "Window", title, FALLBACK_ICON)


def clamp(v, lo, hi):
    return max(lo, min(hi, int(v)))


# The header is a dark neutral band whose HEADING carries the accent, and a
# selected row is a soft tint with a bar on its left edge: both used to be the
# accent at full strength, so the first (selected) row ran into the header.
# One placeholder, the accent: the enclave's colour, else the theme's.
CSS = """
.sev-header { padding: 18px 22px; background-color: shade(@theme_bg_color, 0.8);
  box-shadow: inset 0 -3px 0 ACCENT; }
.sev-heading { font-size: 150%; font-weight: bold; color: ACCENT; }
.sev-sub { opacity: 0.75; }
.sev-list row { padding: 10px 14px; }
.sev-list row:selected { background-color: alpha(ACCENT, 0.22);
  box-shadow: inset 5px 0 0 ACCENT; }
.sev-list row:selected label { color: @theme_fg_color; }
.sev-app { opacity: 0.7; }
.sev-title { font-weight: bold; font-size: 124%; }
.sev-buttons { padding: 12px 18px; }
.sev-buttons button { padding: 6px 22px; }
"""


def choose(cands, enclave, timeout):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gdk", "4.0")
    from gi.repository import Gdk, Gio, GLib, Gtk

    # The app id, set before GTK opens the display: with no Gtk.Application
    # GTK names the toplevel after the program name.
    GLib.set_prgname(APP_ID)

    # A plain window and its own loop, not a Gtk.Application: that would
    # register on the session bus, and a one-shot prompt has no use for it.
    result = {"line": ""}
    loop = GLib.MainLoop()

    def size():
        """A third of the first monitor's width and half its height, in
        bounds: the desktop runs at scale 1, so a fixed size that suits a
        1080p panel is a postage stamp on a 2880 one."""
        mons = Gdk.Display.get_default().get_monitors()
        if mons.get_n_items():
            g = mons.get_item(0).get_geometry()
            return (clamp(g.width / 3, 640, 1200),
                    clamp(g.height / 2, 480, 1000))
        return 720, 560

    def build():
        colour = os.environ.get("SEVERANCE_ENCLAVE_COLOR", "").strip()
        css = Gtk.CssProvider()
        accent = colour or "@theme_selected_bg_color"
        css.load_from_data(CSS.replace("ACCENT", accent), -1)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        win = Gtk.Window()
        win.set_title("Share from %s" % enclave)
        win.set_default_size(*size())
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        head.add_css_class("sev-header")
        screens = any(c.startswith(SCREEN) for c in cands)
        h1 = Gtk.Label(label="Share a screen or window" if screens else
                       "Share a window", xalign=0)
        h1.add_css_class("sev-heading")
        h2 = Gtk.Label(label="from %s" % enclave, xalign=0)
        h2.add_css_class("sev-sub")
        head.append(h1)
        head.append(h2)
        outer.append(head)

        lst = Gtk.ListBox()
        lst.add_css_class("sev-list")
        lst.set_selection_mode(Gtk.SelectionMode.SINGLE)
        for c in cands:
            name, title, icon = describe(c)
            row = Gtk.Box(spacing=14)
            img = Gtk.Image.new_from_gicon(Gio.Icon.new_for_string(icon))
            img.set_pixel_size(48)
            row.append(img)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2,
                           valign=Gtk.Align.CENTER, hexpand=True)
            a = Gtk.Label(label=name, xalign=0)
            a.add_css_class("sev-app")
            t = Gtk.Label(label=title, xalign=0, ellipsize=3)  # END
            t.add_css_class("sev-title")
            text.append(a)
            text.append(t)
            row.append(text)
            lst.append(row)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_child(lst)
        if cands:
            outer.append(scroll)
        else:
            outer.append(Gtk.Label(
                label="%s has nothing that can be shared." % enclave,
                vexpand=True))

        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        buttons.add_css_class("sev-buttons")
        cancel = Gtk.Button(label="Cancel")
        share = Gtk.Button(label="Share")
        share.add_css_class("suggested-action")
        share.set_sensitive(False)
        buttons.append(cancel)
        if cands:
            buttons.append(share)
        outer.append(buttons)
        win.set_child(outer)

        def done(line):
            if "done" in result:      # a timeout after a click, say
                return
            result["done"] = True
            result["line"] = line
            win.destroy()
            loop.quit()

        def key(_c, kv, _code, _state):
            if kv == Gdk.KEY_Escape:
                done("")
                return True
            return False

        lst.connect("row-selected",
                    lambda _l, row: share.set_sensitive(row is not None))
        lst.connect("row-activated",
                    lambda _l, row: done(cands[row.get_index()]))
        share.connect("clicked", lambda _b: done(
            cands[lst.get_selected_row().get_index()]))
        cancel.connect("clicked", lambda _b: done(""))
        win.connect("close-request", lambda _w: done("") or False)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", key)
        win.add_controller(keys)
        GLib.timeout_add_seconds(timeout, lambda: done("") or False)
        win.present()
        if cands:
            first = lst.get_row_at_index(0)
            lst.select_row(first)
            first.grab_focus()

    build()
    loop.run()
    return result["line"]


def main(argv):
    cands = candidates(sys.stdin)
    if argv[1:] == ["--candidates"]:
        for c in cands:
            print(c)
        return 0
    if argv[1:] == ["--rows"]:
        for c in cands:
            print("\t".join(describe(c)))
        return 0
    enclave = os.environ.get("SEVERANCE_ENCLAVE", "this enclave")
    try:
        timeout = max(1, int(os.environ.get("SEVERANCE_CHOOSER_TIMEOUT",
                                            "120")))
    except ValueError:
        timeout = 120
    line = choose(cands, enclave, timeout)
    if line:
        print(line, flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
