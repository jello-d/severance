#!/bin/sh
# severance-tray-bus <enclave>: the enclave's TRAY BUS. Runs AS the enclave
# account, in its user manager (share/units/severance-tray@.service), and
# serves a FILTERED view of the enclave's session bus at
#
#     <share root>/<enclave>/enclave/tray-bus
#
# for the owner's tray host: it may own org.kde.StatusNotifierWatcher there
# (so the enclave's apps register their icons with it) and talk to org.kde.*
# names (the items and their menus), and NOTHING else on that bus: not the
# keyring, the portals, or any other service. The policy is HERE, once, so
# the unit and the test run the same thing (docs/enclave-user.md).
#
# LIMITS, measured by the tray's builders: an item registered by its unique
# name (:1.N) is unreachable through a name filter, and `org.kde.*` also
# admits any other org.kde service the enclave runs (none by default).
#
# The directory is the account's, group the owner's, setgid 2710, so the
# socket lands in the owner's group; umask 0007 makes it connectable by that
# group and nobody else.
set -eu
case ${1:-} in
  ''|*[!a-z0-9-]*|-*|*-)
    echo "usage: severance-tray-bus <enclave>" >&2; exit 2 ;;
esac
dir=${SEVERANCE_SHARE_ROOT:-/run/severance}/$1/enclave
up=${SEVERANCE_TRAY_UPSTREAM:-unix:path=${XDG_RUNTIME_DIR:?}/bus}
[ -d "$dir" ] || {
  echo "severance-tray-bus: $dir missing (provision makes it)" >&2; exit 1; }
umask 0007
# A socket left by a previous run would make the bind fail.
rm -f "$dir/tray-bus"
exec xdg-dbus-proxy "$up" "$dir/tray-bus" --filter \
  --own=org.kde.StatusNotifierWatcher --talk='org.kde.*'
