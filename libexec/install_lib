# install_lib - the `install` / `uninstall` verbs, which DELEGATE to setup.sh.
# Sourced by bin/severance.
#
# ONE INSTALLER, AND IT HAS TO BE setup.sh, for a reason this verb cannot work
# around: setup.sh always sits at the root of the SOURCE tree, so what it copies
# FROM is never in doubt. bin/severance self-locates, which is correct for
# finding its own libexec and exactly wrong for finding a source: on an
# installed box `severance install` resolves its "package root" to the PAYLOAD
# (~/.local/share/severance), and an installer whose source is its own
# destination is at best a no-op and at worst stages a tree over itself. That
# was survivable while the install was a handful of symlinks; it is not now
# that the install is a copy.
#
# So this resolves the source and hands over, and FAILS LOUD where there is no
# source to hand over to, which is precisely the installed-payload case. It
# stays a verb because the README documents it and a standalone user types it,
# but it is a SPELLING of setup.sh, never a second implementation.
sev_setup() {   # <install|uninstall>
  _sv_bin=${SEVERANCE_SELF%/*}            # .../bin
  _sv_root=${_sv_bin%/*}                  # the package root
  _sv=$_sv_root/setup.sh
  if [ ! -r "$_sv" ]; then
    echo "severance: no setup.sh at $_sv_root, so there is nothing to" >&2
    echo "  install FROM. You are running the installed payload, not a" >&2
    echo "  source tree: run 'sh setup.sh $1' from a severance checkout" >&2
    echo "  (or let your provisioner do it, which is the usual answer on a" >&2
    echo "  host-managed box)." >&2
    return 1
  fi
  exec sh "$_sv" "$1"
}
