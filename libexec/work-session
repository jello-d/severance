#!/bin/sh
# work-session - runs AS AN ENCLAVE ACCOUNT, started by `work` through
# `sudo -iu <account>` (docs/enclave-user.md). It brings in the enclave's
# environment, then becomes an interactive shell or runs the given command.
#
# WHY IT EXISTS: environment.d (where severance writes the enclave's display,
# audio and docker paths) is read by the account's USER MANAGER, for what the
# manager starts. A `sudo -i` login shell is started by sudo, not by the
# manager, and does not see it. Measured: DOCKER_HOST set in the manager and
# in a unit it starts, absent in a `sudo -iu` shell.
#
# HOW: systemd's own user environment-GENERATORS, ALL of them, run as the
# manager runs them, so the values and the merge rules are exactly what the
# manager gets. The environment.d one prints KEY=VALUE, shell-quoting
# a value with spaces as KEY="a b" and escaping with backslashes; that one
# level of quoting is undone here and each line is EXPORTED AS DATA. Nothing
# is eval'd, so a value can never run as code.
#
# Shipped in the SHARED install (/opt/severance) only: it runs as the enclave
# account, which cannot read the login user's home, and `work` refuses a copy
# that is not root-owned.
set -eu

# THE CALLER'S SESSION STOPS HERE. sudo keeps a few of the invoking user's
# variables (sudo-rs's env_keep includes DISPLAY), so the enclave arrived
# holding pointers into the OWNER's session. Measured: an app inside was
# handed the owner's X display, chose X11 because of it, was refused (by
# design: Xwayland admits no other uid) and died. The enclave has its own
# display, bus and runtime dir and NO X server, so every such pointer only
# sends an app to a session it cannot use. Dropped BEFORE environment.d is
# read, so the enclave's own values are the only ones left.
unset DISPLAY XAUTHORITY XAUTHORIZATION WAYFIRE_SOCKET SWAYSOCK \
  WAYLAND_SOCKET SSH_AUTH_SOCK
_rt=/run/user/$(id -u)
case ${XDG_RUNTIME_DIR:-} in "$_rt"|'') ;; *) unset XDG_RUNTIME_DIR ;; esac
case ${DBUS_SESSION_BUS_ADDRESS:-} in
  "unix:path=$_rt/bus"|'') ;;
  *) unset DBUS_SESSION_BUS_ADDRESS ;;
esac

# Each generator's output, one line per assignment, EXPORTED AS DATA. Unquote
# KEY="..." (backslash escapes \" \\ \$ \` inside it), leave KEY=bare alone,
# and drop anything that is not KEY=. Nothing is eval'd.
_ws_apply() {   # <generator output>
  _ws_e=$(printf '%s\n' "$1" | sed -n \
    -e '/^[A-Za-z_][A-Za-z0-9_]*="/{
          s/^\([A-Za-z_][A-Za-z0-9_]*\)="\(.*\)"$/\1=\2/
          s/\\\(["\\$`]\)/\1/g
          p
          d
        }' \
    -e '/^[A-Za-z_][A-Za-z0-9_]*=/p')
  set -f
  _ws_ifs=$IFS
  IFS='
'
  for _ws_l in $_ws_e; do export "$_ws_l"; done
  IFS=$_ws_ifs
  set +f
}

# EVERY user environment-generator, as the account's own manager runs them:
# each NAME once, the first directory holding it wins (an empty file or a
# /dev/null link MASKS it), in name order, each seeing what the earlier ones
# exported. Pinning the environment.d generator by name was complete only
# while it was the only one; a second (a per-account token, root-owned) now
# exists on real boxes, and the manager ran it while this did not.
# SEVERANCE_ENV_GENERATOR_DIRS is the test seam.
_ws_g=user-environment-generators
_ws_dirs=${SEVERANCE_ENV_GENERATOR_DIRS:-"/run/systemd/$_ws_g
/etc/systemd/$_ws_g
/usr/local/lib/systemd/$_ws_g
/usr/lib/systemd/$_ws_g
/lib/systemd/$_ws_g"}
_ws_envd=30-systemd-environment-d-generator
_ws_seen=
for _ws_n in $(for _ws_d in $_ws_dirs; do
                 for _ws_f in "$_ws_d"/*; do
                   [ -e "$_ws_f" ] || [ -L "$_ws_f" ] || continue
                   printf '%s\n' "${_ws_f##*/}"
                 done
               done | LC_ALL=C sort -u); do
  for _ws_d in $_ws_dirs; do
    [ -e "$_ws_d/$_ws_n" ] || [ -L "$_ws_d/$_ws_n" ] || continue
    if [ -x "$_ws_d/$_ws_n" ] && [ -s "$_ws_d/$_ws_n" ]; then
      if _ws_o=$("$_ws_d/$_ws_n"); then
        _ws_apply "$_ws_o"
        [ "$_ws_n" = "$_ws_envd" ] && _ws_seen=1
      else
        echo "work-session: WARN generator $_ws_d/$_ws_n failed;" \
          "its variables are missing" >&2
      fi
    fi
    break
  done
done
[ -n "$_ws_seen" ] || {
  echo "work-session: systemd's environment.d generator not found" \
    "(or it failed), so the enclave has no environment" >&2
  exit 1; }

# `work run` arrives through a NON-login sudo (so its argv is not re-parsed
# by a shell), which opens no session: supply the runtime dir and the session
# bus from the account's own lingering session when they are missing.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "$_rt" ] && [ -O "$_rt" ]; then
  export XDG_RUNTIME_DIR="$_rt"
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/x}/bus" ]
then export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"; fi

[ -n "${SEVERANCE_ENCLAVE:-}" ] ||
  echo "work-session: WARN no SEVERANCE_ENCLAVE in environment.d" \
    "(has the enclave been provisioned?)" >&2
cd "$HOME"
if [ "$#" -gt 0 ]; then exec "$@"; fi
exec "${SHELL:-/bin/sh}" -i
