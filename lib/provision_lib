# provision_lib - the PRIVILEGED half of the enclave-user model
# (docs/enclave-user.md): declare an enclave in the registry. Sourced by
# bin/severance after common_lib (which brings enclave_lib).
#
#   severance enclave add <name> owner=<user> [key=val ...]
#
# Run AS ROOT, by a human through sudo or by an integrator's root-scope
# provisioning. Nothing here calls sudo: a verb that escalates on its own is a
# verb an unprivileged caller can drive.

# Root runs these, and root executing a file its user can change is privilege
# escalation, so they refuse to run from an install anyone but root could
# have written. Checked on the REAL path of the running command and on its
# lib. A test registry (SEVERANCE_ENCLAVES_DIR) is the one seam: no root is
# involved there, so neither check applies.
_pv_privileged() {   # <verb>
  [ -n "${SEVERANCE_ENCLAVES_DIR:-}" ] && return 0
  if [ "$(id -u)" != 0 ]; then
    echo "severance: '$1' changes the box; run it as root" >&2
    return 1
  fi
  # The command, and EVERY file it sources, not just their directory.
  _pv_open=$(find -L "$SEVERANCE_SELF" "$SEV_LIB" \( ! -user 0 \
    -o -perm -g+w -o -perm -o+w \) -print 2>/dev/null | head -1)
  [ -z "$_pv_open" ] && return 0
  echo "severance: refusing '$1' as root: $_pv_open is not root-owned" >&2
  echo "  and closed. Root must run the SHARED install" >&2
  echo "  (sudo sh setup.sh install --system), never a user's copy." >&2
  return 1
}

# The scratch dir holds exactly one file, so it is removed by name and
# rmdir'd: no rm -rf of a computed path.
_pv_clean() {   # <dir> <name>
  rm -f "$1/$2"
  rmdir "$1" 2>/dev/null || :
}

sev_enclave() {
  _pv_sub=${1:-}
  [ "$#" -gt 0 ] && shift
  case $_pv_sub in
    add)       _pv_add "$@" ;;
    provision) _pv_provision "$@" ;;
    check)     _pv_check "$@" ;;
    *) echo "usage: severance enclave add <name> owner=<user> [key=val ...]" \
         >&2
       echo "       severance enclave provision|check [name ...]" >&2
       return 2 ;;
  esac
}

# Write (or update) one record, VALIDATED by the same reader every consumer
# uses before it lands, and swapped in atomically, so the registry never holds
# a half-written or unparseable record. Re-running with the same values is a
# no-op that says so.
_pv_add() {   # <name> key=val...
  _pv_n=${1:-}
  [ -n "$_pv_n" ] || {
    echo "usage: severance enclave add <name> owner=<user> [key=val ...]" >&2
    return 2; }
  shift
  _pv_privileged "enclave add" || return 1
  _pv_tmp=$(mktemp -d) || return 1
  for _pv_kv in "$@"; do
    case $_pv_kv in
      *=*) printf '%s\n' "$_pv_kv" ;;
      *) echo "severance: not key=val: $_pv_kv" >&2
         _pv_clean "$_pv_tmp" "$_pv_n"; return 2 ;;
    esac
  done > "$_pv_tmp/$_pv_n"
  # Validate with the reader itself, pointed at the scratch copy. Saved and
  # restored by hand: an assignment prefixed to a FUNCTION call may outlive
  # it in POSIX sh, which would aim the write below at the scratch dir.
  _pv_reg=$SEV_ENCLAVES_DIR
  SEV_ENCLAVES_DIR=$_pv_tmp
  _pv_ok=0; en_load "$_pv_n" || _pv_ok=$?
  SEV_ENCLAVES_DIR=$_pv_reg
  if [ "$_pv_ok" != 0 ]; then _pv_clean "$_pv_tmp" "$_pv_n"; return 2; fi
  _pv_new_owner=$EN_OWNER
  _pv_rec=$SEV_ENCLAVES_DIR/$_pv_n
  _pv_owner_change "$_pv_n" "$_pv_new_owner" || {
    _pv_clean "$_pv_tmp" "$_pv_n"; return 1; }
  if cmp -s "$_pv_tmp/$_pv_n" "$_pv_rec"; then
    _pv_clean "$_pv_tmp" "$_pv_n"
    echo "severance: enclave '$_pv_n' current ($_pv_rec)"
    return 0
  fi
  mkdir -p "$SEV_ENCLAVES_DIR" || {
    _pv_clean "$_pv_tmp" "$_pv_n"; return 1; }
  cp "$_pv_tmp/$_pv_n" "$_pv_rec.new" && chmod 0644 "$_pv_rec.new" &&
    mv -f "$_pv_rec.new" "$_pv_rec" || {
      rm -f "$_pv_rec.new"; _pv_clean "$_pv_tmp" "$_pv_n"
      echo "severance: could not write $_pv_rec" >&2; return 1; }
  _pv_clean "$_pv_tmp" "$_pv_n"
  echo "severance: enclave '$_pv_n' declared ($_pv_rec)"
}

# The account name is <owner>-<name>, so changing the owner of an enclave
# whose account EXISTS would orphan that account and everything it owns under
# a name nothing derives any more. Refused; retire the enclave first.
_pv_owner_change() {   # <name> <new owner>
  [ -r "$SEV_ENCLAVES_DIR/$1" ] || return 0
  en_load "$1" 2>/dev/null || return 0
  [ "$EN_OWNER" = "$2" ] && return 0
  [ "$EN_UID" = - ] && return 0
  echo "severance: enclave '$1' belongs to '$EN_OWNER' and its account" >&2
  echo "  $EN_ACCOUNT exists; changing the owner would orphan it. Run" >&2
  echo "  'severance forget $1' first." >&2
  return 1
}

# --- provision: make a declared enclave real ----------------------------------
# `severance enclave provision [name...]` (every registry enclave when none is
# named). Idempotent: each step checks before it acts and says which it did.
# SEVERANCE_DRYRUN prints the mutating commands instead of running them.
LOGIN_DEFS=${LOGIN_DEFS:-/etc/login.defs}
SUBUID=${SUBUID:-/etc/subuid}
SUBGID=${SUBGID:-/etc/subgid}
TMPFILES_DIR=${TMPFILES_DIR:-/etc/tmpfiles.d}
LINGER_DIR=${LINGER_DIR:-/var/lib/systemd/linger}
SYSTEMD_UNIT_DIR=${SYSTEMD_UNIT_DIR:-/etc/systemd/system}
DOCKERD_ROOTLESS=${DOCKERD_ROOTLESS:-/usr/bin/dockerd-rootless.sh}
_PV_UNIT=severance-dockerd@.service
SYSTEMD_USER_UNIT_DIR=${SYSTEMD_USER_UNIT_DIR:-/etc/systemd/user}
_PV_DISPLAY=severance-display@.service
# Every USER unit an enclave gets, as <template>:<whose session runs it>.
_PV_USER_UNITS="severance-display@.service:owner
severance-notify-owner@.service:owner
severance-notify-enclave@.service:enclave"
# Device groups every enclave account joins: the GPU render node and the
# cameras. Decided 2026-11-01: by group, always. Cameras carry the uaccess
# tag, which ACLs them only to the owner of the seat's active session, and
# an enclave never owns a seat session, so a group is the working grant.
# PipeWire camera access through the owner's session is the successor.
SEV_DEVICE_GROUPS=${SEV_DEVICE_GROUPS-video render}

_pv_do() {
  if [ -n "${SEVERANCE_DRYRUN:-}" ]; then echo "dry-run: $*"; return 0; fi
  "$@"
}

# The first uid a REGULAR user gets; below it is the system range.
_pv_uid_min() {
  awk '$1 == "UID_MIN" { v = $2 } END { print (v ? v : 1000) }' \
    "$LOGIN_DEFS" 2>/dev/null || echo 1000
}

_pv_provision() {   # [name...]
  _pv_privileged "enclave provision" || return 1
  [ "$#" -gt 0 ] || set -- $(en_names)
  _pv_rc=0
  for _pv_e in "$@"; do
    if en_load "$_pv_e" && _pv_provision_one; then
      echo "severance: enclave '$_pv_e' provisioned ($EN_ACCOUNT)"
    else
      echo "severance: enclave '$_pv_e' provisioning FAILED" >&2; _pv_rc=1
    fi
  done
  return "$_pv_rc"
}

_pv_provision_one() {
  getent passwd "$EN_OWNER" >/dev/null 2>&1 || {
    echo "severance: owner '$EN_OWNER' is not an account here" >&2
    return 1; }
  _pv_account || return 1
  _pv_groups || return 1
  _pv_subids uid "$SUBUID" --add-subuids || return 1
  _pv_subids gid "$SUBGID" --add-subgids || return 1
  # environment.d BEFORE linger: linger starts the user manager at once,
  # and a manager reads environment.d when it starts (and on reload), so the
  # other order starts it without the enclave's environment. Measured.
  _pv_share_dir || return 1
  _pv_environment || return 1
  _pv_portal || return 1
  _pv_linger || return 1
  _pv_docker || return 1
  _pv_user_units || return 1
}

# The account: system range, its own user-private group, the owner's shell
# (so `sudo -i` feels like home), home 0700. An EXISTING account of that name
# must already look exactly like ours, or it is not ours to adopt.
_pv_account() {
  if ! getent passwd "$EN_ACCOUNT" >/dev/null 2>&1; then
    _pv_sh=$(getent passwd "$EN_OWNER" | cut -d: -f7)
    _pv_do useradd --system --user-group --create-home \
      --home-dir "$EN_HOME" --shell "${_pv_sh:-/bin/sh}" \
      --comment "severance enclave $EN_NAME" "$EN_ACCOUNT" || return 1
    echo "severance: created account $EN_ACCOUNT"
    [ -n "${SEVERANCE_DRYRUN:-}" ] && return 0
  fi
  _pv_ent=$(getent passwd "$EN_ACCOUNT")
  _pv_u=$(echo "$_pv_ent" | cut -d: -f3)
  _pv_g=$(getent group "$(echo "$_pv_ent" | cut -d: -f4)" | cut -d: -f1)
  if [ "$_pv_u" -ge "$(_pv_uid_min)" ]; then
    echo "severance: $EN_ACCOUNT is uid $_pv_u, a REGULAR account; an" >&2
    echo "  enclave account is system range. Not adopting it." >&2
    return 1
  fi
  [ "$_pv_g" = "$EN_ACCOUNT" ] || {
    echo "severance: $EN_ACCOUNT's primary group is '$_pv_g', not its own" >&2
    return 1; }
  [ "$(echo "$_pv_ent" | cut -d: -f6)" = "$EN_HOME" ] || {
    echo "severance: $EN_ACCOUNT's home is not $EN_HOME" >&2; return 1; }
  _pv_do chmod 0700 "$EN_HOME"
}

# Supplementary device groups, idempotent. A group this box does not have is
# named, not silently skipped and not fatal: no such group is usually no
# such device.
_pv_groups() {
  for _pv_dg in $SEV_DEVICE_GROUPS; do
    _pv_gl=$(getent group "$_pv_dg") || {
      echo "severance: WARN no '$_pv_dg' group on this box" >&2; continue; }
    case ",$(echo "$_pv_gl" | cut -d: -f4)," in
      *",$EN_ACCOUNT,"*) continue ;;
    esac
    _pv_do usermod -aG "$_pv_dg" "$EN_ACCOUNT" || return 1
    echo "severance: $EN_ACCOUNT joined $_pv_dg"
  done
}

# Subordinate ids for rootless containers: the next free 65536 block past
# every existing allocation. (runner_lib keeps its own copy until the group
# model is retired with it.)
_pv_subids() {   # uid|gid <file> <usermod flag>
  if grep -q "^$EN_ACCOUNT:" "$2" 2>/dev/null; then return 0; fi
  _pv_r=$(awk -F: 'BEGIN{m=100000}{e=$2+$3; if(e>m)m=e}
    END{printf "%d-%d\n", m, m+65535}' "$2" 2>/dev/null) ||
    _pv_r=100000-165535
  _pv_do usermod "$3" "$_pv_r" "$EN_ACCOUNT" || return 1
  echo "severance: $EN_ACCOUNT $1 range $_pv_r"
}

# Linger keeps the enclave's user manager up, so a launched app has a
# session to land in. Safe because the account is system range: a session
# gate on `!@system` keeps its manager off the sound card.
_pv_linger() {
  [ -e "$LINGER_DIR/$EN_ACCOUNT" ] && return 0
  _pv_do loginctl enable-linger "$EN_ACCOUNT" || return 1
  echo "severance: $EN_ACCOUNT lingers"
}

# The share dir: owned by the OWNER, group the account's own, 0710, so the
# enclave can traverse to a socket it names and nothing else, and only the
# owner's session creates sockets there. Two tmpfiles fragments, so the
# common parent is declared once however many enclaves exist. PURE renders,
# so a test pins the modes without root.
_pv_render_parent() {
  printf 'd %s 0755 root root -\n' "$SEV_SHARE_ROOT"
}
_pv_render_share() {
  printf 'd %s 0710 %s %s -\n' "$EN_SHARE" "$EN_OWNER" "$EN_ACCOUNT"
}
_pv_tmpfile() {   # <path> <render function>
  _pv_t=$(mktemp) || return 1
  "$2" > "$_pv_t"
  if cmp -s "$_pv_t" "$1"; then rm -f "$_pv_t"; return 0; fi
  _pv_do install -m 0644 -o root -g root "$_pv_t" "$1" || {
    rm -f "$_pv_t"; return 1; }
  rm -f "$_pv_t"
  echo "severance: wrote $1"
}
_pv_share_dir() {
  _pv_tmpfile "$TMPFILES_DIR/severance.conf" _pv_render_parent || return 1
  _pv_tmpfile "$TMPFILES_DIR/severance-$EN_NAME.conf" _pv_render_share ||
    return 1
  _pv_do systemd-tmpfiles --create "$TMPFILES_DIR/severance.conf" \
    "$TMPFILES_DIR/severance-$EN_NAME.conf"
}

# The enclave session's environment, ONE file in its own environment.d,
# because every value derives from the enclave name. Written AS THE ACCOUNT:
# the directory is the enclave's, and root writing into a directory its
# owner controls can be steered by a planted symlink to any file on the box.
_pv_render_env() {
  echo "# Written by severance for enclave $EN_NAME; re-written on every"
  echo "# provision. Change the enclave record, not this file."
  echo "SEVERANCE_ENCLAVE=$EN_NAME"
  echo "WAYLAND_DISPLAY=$EN_SHARE/wayland-0"
  echo "PULSE_SERVER=unix:$EN_SHARE/pulse"
  [ "$EN_DOCKER" = yes ] &&
    echo "DOCKER_HOST=unix:///run/severance-docker-$EN_ACCOUNT/docker.sock"
  return 0
}
_pv_environment() {
  _pv_account_file .config/environment.d 50-severance.conf _pv_render_env ||
    return 1
  [ "$_pv_wrote" = 1 ] || return 0
  _pv_reload_env
}

# Write one file of severance-derived configuration into the enclave's home,
# AS THE ACCOUNT, and read it back as the account to compare: the directory
# is the enclave's, and root writing into a directory its owner controls can
# be steered by a planted symlink to any file on the box. Sets _pv_wrote.
_pv_account_file() {   # <dir under home> <file> <render function>
  _pv_wrote=0
  _pv_ed=$EN_HOME/$1
  _pv_t=$(mktemp) || return 1
  "$3" > "$_pv_t"
  if [ -z "${SEVERANCE_DRYRUN:-}" ] &&
     runuser -u "$EN_ACCOUNT" -- cat "$_pv_ed/$2" 2>/dev/null |
       cmp -s "$_pv_t" -; then
    rm -f "$_pv_t"; return 0
  fi
  chmod 0644 "$_pv_t"
  _pv_do runuser -u "$EN_ACCOUNT" -- sh -c 'mkdir -p "$1" &&
    cat > "$1/$2.new" && mv -f "$1/$2.new" "$1/$2"' _ "$_pv_ed" "$2" \
    < "$_pv_t" || { rm -f "$_pv_t"; return 1; }
  rm -f "$_pv_t"
  _pv_wrote=1
  echo "severance: wrote $_pv_ed/$2"
}

# The enclave's screen-share PORTAL: sharing goes to the wlroots portal, and
# its chooser is this install's severance-share-chooser (an ordinary window,
# windows only), because the usual pickers are overlays an enclave may not
# open. Everything else goes to the gtk portal. Both name THIS install, so
# they are rendered, not shipped.
_pv_render_portals() {
  echo "# Written by severance for enclave $EN_NAME; re-written on every"
  echo "# provision."
  echo "[preferred]"
  echo "default=gtk"
  echo "org.freedesktop.impl.portal.ScreenCast=wlr"
}
_pv_render_xdpw() {
  echo "# Written by severance for enclave $EN_NAME; re-written on every"
  echo "# provision."
  echo "[screencast]"
  echo "chooser_type=dmenu"
  echo "chooser_cmd=${SEVERANCE_SELF%/bin/*}/libexec/severance-share-chooser"
}
_pv_portal() {
  _pv_account_file .config/xdg-desktop-portal portals.conf \
    _pv_render_portals || return 1
  _pv_account_file .config/xdg-desktop-portal-wlr config _pv_render_xdpw
}

# A RUNNING manager keeps the environment it started with until it reloads,
# so a changed file must be followed by a reload or it waits for a reboot.
# Services already running keep the old values; new ones get the new.
_pv_reload_env() {
  _pv_ru=$(getent passwd "$EN_ACCOUNT" 2>/dev/null | cut -d: -f3)
  [ -n "$_pv_ru" ] || return 0
  systemctl is-active --quiet "user@$_pv_ru.service" 2>/dev/null ||
    return 0
  _pv_do runuser -u "$EN_ACCOUNT" -- env "XDG_RUNTIME_DIR=/run/user/$_pv_ru" \
    systemctl --user daemon-reload || return 1
  echo "severance: $EN_ACCOUNT's session reloaded its environment"
}

# --- check: is each declared enclave what provision makes? --------------------
# Read-only and runnable unprivileged; what only root can see inside the
# 0700 home is reported UNVERIFIABLE rather than guessed. Markers fold into
# REPORT_RC like every other check.
_pv_check() {   # [name...]
  echo "== severance enclaves (one account per enclave) =="
  [ "$#" -gt 0 ] || set -- $(en_names)
  _pv_check_template
  [ "$#" -gt 0 ] || { _ok "no enclaves declared"; return "$REPORT_RC"; }
  for _pv_e in "$@"; do
    echo "-- $_pv_e --"
    if ! en_load "$_pv_e"; then _bad "$_pv_e: record does not parse"
      continue; fi
    _pv_check_account
    _pv_check_ids
    _pv_check_share
    _pv_check_docker
    _pv_check_user_units
  done
  return "$REPORT_RC"
}

_pv_check_account() {
  if [ "$EN_UID" = - ]; then _bad "$EN_ACCOUNT: account missing"; return; fi
  if [ "$EN_UID" -lt "$(_pv_uid_min)" ]; then
    _ok "$EN_ACCOUNT: system uid $EN_UID"
  else _bad "$EN_ACCOUNT: uid $EN_UID is in the REGULAR range"; fi
  _pv_gid=$(getent passwd "$EN_ACCOUNT" | cut -d: -f4)
  if [ "$(getent group "$_pv_gid" | cut -d: -f1)" = "$EN_ACCOUNT" ]; then
    _ok "$EN_ACCOUNT: its own primary group"
  else _bad "$EN_ACCOUNT: primary group is not its own"; fi
  for _pv_dg in $SEV_DEVICE_GROUPS; do
    case ",$(getent group "$_pv_dg" | cut -d: -f4)," in
      *",$EN_ACCOUNT,"*) _ok "$EN_ACCOUNT: in $_pv_dg" ;;
      *) if getent group "$_pv_dg" >/dev/null; then
           _bad "$EN_ACCOUNT: not in $_pv_dg"
         else _warn "no '$_pv_dg' group on this box"; fi ;;
    esac
  done
  _pv_hs=$(stat -c '%U %a' "$EN_HOME" 2>/dev/null || echo missing)
  if [ "$_pv_hs" = "$EN_ACCOUNT 700" ]; then _ok "$EN_HOME: 0700, its own"
  else _bad "$EN_HOME: $_pv_hs, want '$EN_ACCOUNT 700'"; fi
}

_pv_check_ids() {
  if grep -q "^$EN_ACCOUNT:" "$SUBUID" 2>/dev/null &&
     grep -q "^$EN_ACCOUNT:" "$SUBGID" 2>/dev/null; then
    _ok "$EN_ACCOUNT: subuid and subgid ranges"
  else _bad "$EN_ACCOUNT: subordinate id range missing"; fi
  if [ -e "$LINGER_DIR/$EN_ACCOUNT" ]; then _ok "$EN_ACCOUNT: lingers"
  else _bad "$EN_ACCOUNT: linger is off"; fi
}

_pv_check_share() {
  if _pv_render_share | cmp -s - "$TMPFILES_DIR/severance-$EN_NAME.conf" &&
     _pv_render_parent | cmp -s - "$TMPFILES_DIR/severance.conf"; then
    _ok "share dir declared ($TMPFILES_DIR)"
  else _bad "share dir tmpfiles missing or stale"; fi
  _pv_ss=$(stat -c '%U %G %a' "$EN_SHARE" 2>/dev/null || echo missing)
  if [ "$_pv_ss" = "$EN_OWNER $EN_ACCOUNT 710" ]; then
    _ok "$EN_SHARE: $EN_OWNER:$EN_ACCOUNT 0710"
  else _bad "$EN_SHARE: $_pv_ss, want '$EN_OWNER $EN_ACCOUNT 710'"; fi
  if [ "$(id -u)" != 0 ]; then
    _ok "environment.d unverifiable here (inside a 0700 home; run as root)"
  elif _pv_render_env | cmp -s - \
       "$EN_HOME/.config/environment.d/50-severance.conf"; then
    _ok "environment.d current"
  else _bad "environment.d missing or stale (re-run provision)"; fi
  [ "$(id -u)" = 0 ] || return 0
  if _pv_render_portals | cmp -s - \
       "$EN_HOME/.config/xdg-desktop-portal/portals.conf" &&
     _pv_render_xdpw | cmp -s - \
       "$EN_HOME/.config/xdg-desktop-portal-wlr/config"; then
    _ok "screen-share portal config current"
  else _bad "screen-share portal config missing or stale"; fi
}

# --- forget: retire an enclave, verified --------------------------------------
# `severance forget <enclave> [--purge]` (as root). Default RETIRES: the
# account goes, its home is KEPT, renamed <home>.retired-<stamp> and owned
# by root, because a freed uid is reissued to the next account created and
# would inherit whatever the old one owned. --purge lets `userdel -r` delete
# the home and removes the record too. Nothing here runs rm -rf; a retired
# home is deleted by hand, and the literal command is printed for that.
_pv_forget() {   # <name> <purge 0|1>
  _pv_privileged "forget" || return 1
  en_load "$1" || return 1
  echo "severance: forgetting enclave '$1' (account $EN_ACCOUNT)"
  if [ "$EN_UID" != - ]; then
    # Its docker first: a system unit running AS the account is one more
    # owner of its processes, and userdel refuses while any survive.
    _pv_do systemctl disable --now "severance-dockerd@$EN_ACCOUNT.service" \
      2>/dev/null || :
    _pv_stop_session || return 1
    # The account goes FIRST, verified, and only then is the home retired:
    # a userdel that fails must leave everything where it was, so the
    # forget can simply be re-run. Retiring first left an account whose
    # home had already moved away (found by a test that flaked on it).
    if [ "$2" = 1 ]; then _pv_do userdel -r "$EN_ACCOUNT" 2>/dev/null || :
    else _pv_do userdel "$EN_ACCOUNT" || :
    fi
    _pv_account_gone || return 1
    [ "$2" = 1 ] || _pv_retire_home || return 1
    _pv_do sed -i "/^$EN_ACCOUNT:/d" "$SUBUID" "$SUBGID"
  else
    echo "  account $EN_ACCOUNT already absent"
  fi
  for _pv_uu in $_PV_USER_UNITS; do
    _pv_inst=${_pv_uu%%@*}@$1.service
    _pv_in_session "${_pv_uu#*:}" stop "$_pv_inst"
    _pv_do systemctl --global disable "$_pv_inst" 2>/dev/null || :
  done
  _pv_unshare
  [ "$2" = 1 ] || { echo "  record kept: $SEV_ENCLAVES_DIR/$1"; return 0; }
  _pv_do rm -f "$SEV_ENCLAVES_DIR/$1"
  echo "  record removed"
  if ! _pv_any_others "$1"; then
    for _pv_uu in $_PV_USER_UNITS; do
      _pv_tpl=${_pv_uu%%:*}
      [ -e "$SYSTEMD_USER_UNIT_DIR/$_pv_tpl" ] || continue
      _pv_do rm -f "$SYSTEMD_USER_UNIT_DIR/$_pv_tpl"
      echo "  removed $_pv_tpl (no enclave left)"
    done
  fi
  _pv_docker_others "$1" && return 0
  [ -e "$SYSTEMD_UNIT_DIR/$_PV_UNIT" ] || return 0
  _pv_do rm -f "$SYSTEMD_UNIT_DIR/$_PV_UNIT"
  _pv_do systemctl daemon-reload
  echo "  removed $_PV_UNIT (no docker enclave left)"
}

# Is any enclave OTHER than <name> declared at all?
_pv_any_others() {   # <name>
  for _pv_o in $(en_names); do [ "$_pv_o" = "$1" ] || return 0; done
  return 1
}

# Does any enclave OTHER than <name> still want docker? The template exists
# exactly while one does: a template nothing uses is a root-owned unit file
# that only rots, and a leftover is how one was first noticed.
_pv_docker_others() {   # <name>
  for _pv_o in $(en_names); do
    [ "$_pv_o" = "$1" ] && continue
    en_load "$_pv_o" 2>/dev/null && [ "$EN_DOCKER" = yes ] && return 0
  done
  return 1
}

# Linger off, the session ended, then WAIT for the account's processes to
# exit: userdel refuses an account that still owns one, and a removal that is
# announced before it happens is the bug `forget` already had once.
_pv_stop_session() {
  [ -e "$LINGER_DIR/$EN_ACCOUNT" ] && _pv_do loginctl disable-linger \
    "$EN_ACCOUNT"
  _pv_do loginctl terminate-user "$EN_ACCOUNT" 2>/dev/null || :
  [ -n "${SEVERANCE_DRYRUN:-}" ] && return 0
  _pv_n=0
  while _pv_left=$(pgrep -u "$EN_UID" 2>/dev/null); do
    _pv_n=$((_pv_n + 1))
    if [ "$_pv_n" -ge 30 ]; then
      echo "severance: $EN_ACCOUNT still owns processes after 30s:" \
        $_pv_left >&2
      return 1
    fi
    sleep 1
  done
}

# Keep the data, take it away from the uid. Shape-checked first: the path is
# exactly this enclave's derived home, so nothing else can be renamed.
_pv_retire_home() {
  [ -d "$EN_HOME" ] || return 0
  case $EN_HOME in "$SEV_HOME_ROOT/$EN_ACCOUNT") ;; *)
    echo "severance: refusing to retire '$EN_HOME'" >&2; return 1 ;; esac
  _pv_to=$EN_HOME.retired-$(date +%Y%m%d%H%M%S)
  _pv_do mv "$EN_HOME" "$_pv_to" || return 1
  _pv_do chown -R root:root "$_pv_to" || return 1
  _pv_do chmod 0700 "$_pv_to"
  echo "  home KEPT, root-owned: $_pv_to"
  echo "  (delete it deliberately: rm -rf $_pv_to)"
}

_pv_account_gone() {
  if [ -n "${SEVERANCE_DRYRUN:-}" ]; then
    echo "  build-only: account $EN_ACCOUNT NOT removed"; return 0
  fi
  if getent passwd "$EN_ACCOUNT" >/dev/null 2>&1; then
    echo "severance: FAILED to remove account $EN_ACCOUNT" >&2; return 1
  fi
  echo "  removed account $EN_ACCOUNT"
  if getent group "$EN_ACCOUNT" >/dev/null 2>&1; then
    _pv_do groupdel "$EN_ACCOUNT" || :
  fi
}

# The share dir's declaration, then the dir itself if it is empty of
# anything but the sockets this package names.
_pv_unshare() {
  _pv_do rm -f "$TMPFILES_DIR/severance-$EN_NAME.conf"
  [ -d "$EN_SHARE" ] || return 0
  _pv_do rm -f "$EN_SHARE/wayland-0" "$EN_SHARE/pulse" "$EN_SHARE/relay"
  _pv_do rmdir "$EN_SHARE" || echo "  $EN_SHARE not empty; left" >&2
}

# --- docker: the enclave's own rootless daemon, a SYSTEM unit instance -------
# The template ships in this package's share/ and is copied into the system
# unit dir by root, from the root-owned shared install, only when it
# differs. The instance name is the account. docker=no turns an enabled
# instance OFF, so the record stays the one place that decides.
_pv_docker() {
  _pv_inst=severance-dockerd@$EN_ACCOUNT.service
  if [ "$EN_DOCKER" != yes ]; then
    systemctl is-enabled --quiet "$_pv_inst" 2>/dev/null || return 0
    _pv_do systemctl disable --now "$_pv_inst" || return 1
    echo "severance: $EN_ACCOUNT docker off (docker=no)"
    return 0
  fi
  [ -x "$DOCKERD_ROOTLESS" ] || {
    echo "severance: $DOCKERD_ROOTLESS missing (docker-ce-rootless-extras)" \
      >&2; return 1; }
  _pv_unit_changed=0
  _pv_unit_file || return 1
  if systemctl is-enabled --quiet "$_pv_inst" 2>/dev/null &&
     systemctl is-active --quiet "$_pv_inst" 2>/dev/null; then
    [ "$_pv_unit_changed" = 1 ] || return 0
    _pv_do systemctl try-restart "$_pv_inst" || return 1
    echo "severance: $EN_ACCOUNT docker restarted (its unit changed)"
    return 0
  fi
  _pv_do systemctl enable --now "$_pv_inst" || return 1
  echo "severance: $EN_ACCOUNT docker up ($_pv_inst)"
}

_pv_unit_file() {
  _pv_src=$SEVERANCE_SHARE/units/$_PV_UNIT
  _pv_dst=$SYSTEMD_UNIT_DIR/$_PV_UNIT
  [ -r "$_pv_src" ] || {
    echo "severance: $_pv_src missing from the install" >&2; return 1; }
  cmp -s "$_pv_src" "$_pv_dst" && return 0
  _pv_do install -m 0644 -o root -g root "$_pv_src" "$_pv_dst" || return 1
  _pv_do systemctl daemon-reload || return 1
  _pv_unit_changed=1
  echo "severance: installed $_pv_dst"
}

# The template is present exactly while some enclave wants docker.
_pv_check_template() {
  [ -e "$SYSTEMD_UNIT_DIR/$_PV_UNIT" ] || return 0
  _pv_docker_others "" && return 0
  _bad "$SYSTEMD_UNIT_DIR/$_PV_UNIT present, but no enclave wants docker"
}

_pv_check_docker() {
  _pv_inst=severance-dockerd@$EN_ACCOUNT.service
  if [ "$EN_DOCKER" != yes ]; then
    if systemctl is-enabled --quiet "$_pv_inst" 2>/dev/null; then
      _bad "$_pv_inst enabled, but the record says docker=no"
    else _ok "docker off (docker=no)"; fi
    return 0
  fi
  if cmp -s "$SEVERANCE_SHARE/units/$_PV_UNIT" "$SYSTEMD_UNIT_DIR/$_PV_UNIT"
  then _ok "$_PV_UNIT current"
  else _bad "$_PV_UNIT missing or stale in $SYSTEMD_UNIT_DIR"; fi
  if systemctl is-active --quiet "$_pv_inst" 2>/dev/null; then
    _ok "$_pv_inst active"
  else _bad "$_pv_inst not active"; fi
}

# --- user units: display socket and notification relay ---------------------
# Templates for the enclave's USER units, rendered with where THIS shared
# install lives (so a relocated or scratch install points at itself), placed
# root-owned into the system user-unit dir, and enabled globally per
# enclave. Each one's ExecCondition lets only the right session run it: the
# owner's (display, the owner's end of the relay) or the enclave's (its end
# of the relay). Started at once where that session is already running.
_pv_render_unit() {   # <template>
  _pv_root=${SEVERANCE_SELF%/bin/*}
  sed -e "s#@LIBEXEC@#$_pv_root/libexec#" \
      -e "s#@SHARE_ROOT@#$SEV_SHARE_ROOT#" \
      "$SEVERANCE_SHARE/units/$1"
}
_pv_render_display() { _pv_render_unit "$_PV_DISPLAY"; }

_pv_user_units() {
  for _pv_uu in $_PV_USER_UNITS; do
    _pv_user_unit "${_pv_uu%%:*}" "${_pv_uu#*:}" || return 1
  done
}

_pv_user_unit() {   # <template> owner|enclave
  _pv_dst=$SYSTEMD_USER_UNIT_DIR/$1
  _pv_t=$(mktemp) || return 1
  _pv_render_unit "$1" > "$_pv_t" || { rm -f "$_pv_t"; return 1; }
  if ! cmp -s "$_pv_t" "$_pv_dst"; then
    _pv_do install -m 0644 -o root -g root "$_pv_t" "$_pv_dst" || {
      rm -f "$_pv_t"; return 1; }
    echo "severance: installed $_pv_dst"
  fi
  rm -f "$_pv_t"
  _pv_inst=${1%@.service}@$EN_NAME.service
  if ! systemctl --global is-enabled --quiet "$_pv_inst" 2>/dev/null; then
    _pv_do systemctl --global enable "$_pv_inst" || return 1
    echo "severance: $_pv_inst enabled"
  fi
  _pv_in_session "$2" start "$_pv_inst"
}

# Named explicitly rather than built from a string, so every call site is
# one a reader (and the suite's dead-code check) can see.
_pv_in_session() {   # owner|enclave start|stop <unit>
  case $1 in
    owner)   _pv_owner_session "$2" "$3" ;;
    enclave) _pv_enclave_session "$2" "$3" ;;
  esac
}

# Act on a user unit in a RUNNING session, as that session's user; nothing
# to do when there is none (the unit starts with the next one). The owner's
# needs a graphical session; the enclave's lingering manager is enough.
_pv_session() {   # <user> <uid> <need graphical 0|1> start|stop <unit>
  systemctl is-active --quiet "user@$2.service" 2>/dev/null || return 0
  _pv_se="XDG_RUNTIME_DIR=/run/user/$2"
  if [ "$3" = 1 ]; then
    runuser -u "$1" -- env "$_pv_se" systemctl --user is-active \
      --quiet graphical-session.target 2>/dev/null || return 0
  fi
  _pv_do runuser -u "$1" -- env "$_pv_se" systemctl --user daemon-reload ||
    :
  _pv_do runuser -u "$1" -- env "$_pv_se" systemctl --user "$4" "$5" ||
    echo "severance: WARN could not $4 $5 in $1's session" >&2
}
_pv_owner_session() {   # start|stop <unit>
  _pv_ou=$(getent passwd "$EN_OWNER" | cut -d: -f3)
  [ -n "$_pv_ou" ] || return 0
  _pv_session "$EN_OWNER" "$_pv_ou" 1 "$1" "$2"
}
_pv_enclave_session() {   # start|stop <unit>
  _pv_eu=$(getent passwd "$EN_ACCOUNT" | cut -d: -f3)
  [ -n "$_pv_eu" ] || return 0
  _pv_session "$EN_ACCOUNT" "$_pv_eu" 0 "$1" "$2"
}

_pv_check_user_units() {
  for _pv_uu in $_PV_USER_UNITS; do
    _pv_tpl=${_pv_uu%%:*}
    if _pv_render_unit "$_pv_tpl" | cmp -s - "$SYSTEMD_USER_UNIT_DIR/$_pv_tpl"
    then _ok "$_pv_tpl current"
    else _bad "$_pv_tpl missing or stale in $SYSTEMD_USER_UNIT_DIR"; fi
    _pv_inst=${_pv_tpl%@.service}@$EN_NAME.service
    if systemctl --global is-enabled --quiet "$_pv_inst" 2>/dev/null; then
      _ok "$_pv_inst enabled"
    else _bad "$_pv_inst not enabled"; fi
  done
}
