# forget_lib - decommission a profile. Sourced by bin/severance.
#
# Default: tear down the RUNNER (reversible: re-run `severance runner` to
# recreate it): stop its --user docker + relay, drop linger, delete the service
# account + its subid/subgid ranges, remove the tmpfiles + /run socket dir + the
# traverse ACL. The WALL and the profile RECORD are left intact.
#
# --purge also removes the record, clears the default marker if it named this
# profile, and regenerates the git fragment for the survivors, but LEAVES the
# work tree SEALED (the data is yours; reclaim it deliberately). The GROUP goes
# only once the tree is gone (see _remove_group). The record removal is
# GUARDED: on a host-managed profiles dir (a symlink) it is left to the host.
sev_forget() {
  _profile= _purge=0
  for _a in "$@"; do
    case "$_a" in
      --purge) _purge=1 ;;
      --*) echo "severance: unknown flag: $_a" >&2; return 2 ;;
      *) _profile=$_a ;;
    esac
  done
  [ -n "$_profile" ] || {
    echo "usage: severance forget <profile> [--purge]" >&2; return 2; }
  # An ENCLAVE (one account per enclave) has its own teardown. A name that
  # is both an enclave and a profile is refused rather than guessed at.
  if [ -f "$SEV_ENCLAVES_DIR/$_profile" ]; then
    if [ -f "$WC_PROFILES_DIR/$_profile" ]; then
      echo "severance: '$_profile' is both an enclave and a profile;" >&2
      echo "  retire the profile first (move its record aside)" >&2
      return 1
    fi
    . "$SEV_LIB/provision_lib"
    _pv_forget "$_profile" "$_purge"
    return
  fi
  wc_load "$_profile" || {
    echo "severance: no such profile: $_profile" >&2; return 1; }
  _r=$WC_RUNNER
  echo "severance: forgetting '$_profile' (runner '$_r')"
  sev_sudo_prime
  _tear_down_runner "$_r" || {
    echo "severance: '$_profile' NOT forgotten; the runner survives" >&2
    return 1; }

  [ "$_purge" = 1 ] || return 0
  _remove_group "$_profile" || return 1
  _purge_record "$_profile"
}

# --purge removes the GROUP too, but only once nothing can still carry its gid.
# A freed id is handed out again by the next groupadd/useradd, so a group
# deleted under a still-sealed tree gives that tree to whoever gets the number
# next. So it stays while work_dir exists, or while another record or an
# account still uses it, and each refusal says which.
_remove_group() {   # <profile>
  _g=$WC_GROUP _wd=$WC_DIR
  if ! getent group "$_g" >/dev/null 2>&1; then
    echo "  group $_g already absent"; return 0
  fi
  if [ -e "$_wd" ] || [ -L "$_wd" ]; then
    echo "  group $_g kept: $_wd still exists and carries its gid"
    return 0
  fi
  _gu=$(_group_users "$1" "$_g")
  if [ -n "$_gu" ]; then
    echo "  group $_g kept: still used by $_gu"; return 0
  fi
  sudo groupdel "$_g" 2>/dev/null || true
  if [ -n "${SEVERANCE_DRYRUN:-}" ]; then
    echo "  build-only: group $_g NOT removed"
  elif getent group "$_g" >/dev/null 2>&1; then
    echo "severance: FAILED to remove group $_g" >&2; return 1
  else
    echo "  removed group $_g"
  fi
}

# Who else still uses <group>: other profile records, and accounts whose
# PRIMARY group it is (a runner forget could not remove). Space-separated.
# Call it in $(...): the wc_load per record clobbers WC_* in its own subshell.
_group_users() {   # <profile> <group>
  _gid=$(getent group "$2" | cut -d: -f3)
  for _o in $(wc_profiles); do
    [ "$_o" = "$1" ] && continue
    wc_load "$_o" && [ "$WC_GROUP" = "$2" ] && printf 'profile:%s ' "$_o"
  done
  getent passwd | awk -F: -v g="$_gid" '$4 == g { printf "account:%s ", $1 }'
}

# Tear down the runner. Remove the traverse ACL BEFORE userdel (while the name
# still resolves), then the --user services, then the account + id ranges.
# Every step tolerates an already-absent piece: this is a decommission, so
# half-torn-down must converge rather than abort partway. What it must NOT do is
# REPORT a piece gone that is not: the account is verified by asking `id`
# afterwards, never inferred from userdel having been called.
_tear_down_runner() {   # <runner>
  _r=$1
  if id "$_r" >/dev/null 2>&1; then
    _ruid=$(id -u "$_r")
    setfacl -x "u:$_r" "$HOME" 2>/dev/null || true
    sudo -u "$_r" env "XDG_RUNTIME_DIR=/run/user/$_ruid" \
      systemctl --user disable --now docker.service work-docker-sock.service \
      2>/dev/null || true
    sudo loginctl disable-linger "$_r" 2>/dev/null || true
    _stop_user_manager "$_r" "$_ruid" || return 1
    sudo userdel -r "$_r" 2>/dev/null || true
    _account_gone "$_r" || return 1
    sudo sed -i "/^$_r:/d" /etc/subuid /etc/subgid 2>/dev/null || true
  else
    echo "  runner account $_r already absent"
  fi
  sudo rm -f "/etc/tmpfiles.d/$_r.conf"
  _remove_socket_dir "/run/$_r"
  echo "  runner torn down (wall + record left intact)"
}

# disable-linger stops the user manager ASYNCHRONOUSLY, and userdel refuses an
# account that still owns a process. Measured on one box 2026-10-13: userdel ran
# in the same second as disable-linger, refused, and the account survived a
# report saying it was removed; the same userdel 4.5 minutes later succeeded.
# So end the session and WAIT for the process table to empty.
_stop_user_manager() {   # <runner> <uid>
  sudo loginctl terminate-user "$1" 2>/dev/null || true
  [ -n "${SEVERANCE_DRYRUN:-}" ] && return 0
  _n=0
  while _left=$(pgrep -u "$2" 2>/dev/null); do
    _n=$((_n + 1))
    if [ "$_n" -ge 30 ]; then
      echo "severance: $1 still owns processes after 30s:" \
        $_left >&2
      echo "  userdel would refuse; NOT removing the account" >&2
      return 1
    fi
    sleep 1
  done
}

# The account is gone only when `id` says so. userdel -r exits non-zero for
# reasons that still delete the account (a missing mail spool), and zero is not
# proof either, so its status is not the question.
_account_gone() {   # <runner>
  if [ -n "${SEVERANCE_DRYRUN:-}" ]; then
    echo "  build-only: runner account $1 NOT removed"
    return 0
  fi
  if id "$1" >/dev/null 2>&1; then
    echo "severance: FAILED to remove runner account $1 (still in" \
      "passwd)" >&2
    return 1
  fi
  echo "  removed runner account $1"
}

# The relay socket's directory holds one socket, so remove exactly that and
# then the directory: rmdir refuses anything unexpected instead of deleting it.
_remove_socket_dir() {   # <dir>
  sudo test -d "$1" || return 0
  sudo rm -f "$1/docker.sock"
  sudo rmdir "$1" \
    || echo "severance: $1 not empty; left in place" >&2
}

# --purge: remove the record (unless host-managed), clear the default marker if
# it named THIS profile, and regenerate the git fragment for the survivors. The
# TREE stays sealed: the data is yours, and reclaiming it is a deliberate act,
# not a side effect of decommissioning a runner.
_purge_record() {   # <profile>
  _profile=$1
  if _sev_host_managed; then
    echo "  profiles dir is host-managed; remove the record at the host" >&2
  else
    rm -f "$WC_PROFILES_DIR/$_profile"
    echo "  removed profile record $_profile"
    if [ -r "$WC_DEFAULT_FILE" ]; then
      IFS= read -r _d < "$WC_DEFAULT_FILE" 2>/dev/null || _d=
      if [ "$_d" = "$_profile" ]; then
        rm -f "$WC_DEFAULT_FILE"; echo "  cleared the default marker"
      fi
    fi
    . "$SEV_LIB/seal_lib"
    if [ -f "$GIT_GEN" ]; then
      render_git_gen > "$GIT_GEN" 2>/dev/null || true
      echo "  regenerated the git fragment"
    fi
  fi
  if [ -e "$WC_DIR" ]; then
    echo "severance: '$_profile' purged. The work tree is left SEALED;"
    echo "  reclaim its data with: sudo chown -R $(id -un) $WC_DIR"
  else
    echo "severance: '$_profile' purged."
  fi
}
