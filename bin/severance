#!/bin/sh
# severance - the work/personal ZDR boundary as a standalone gadget: profile
# records, the sealed kernel wall (2770 root:group tree + ACLs + git identity
# split), and the per-enclave rootless-docker runner. Runs standalone (a box
# with no host) or driven by a host provisioner as a thin delegator.
#
#   severance seal   [profile...]      provision the boundary (privileged)
#   severance runner [profile...]      provision the rootless-docker runner
#   severance check  [--seal|--runner] audit; non-zero on drift (bare = both)
#
# Self-locates its libexec/share beside the binary (through any install
# symlink). Idempotent; privileged verbs prompt sudo
# once up front (a no-op when a cache is already warm, e.g. under a host).
set -eu

_self=$0
case $_self in
  */*) ;;
  *) _self=$(command -v -- "$_self" 2>/dev/null || printf '%s\n' "$_self") ;;
esac
SEVERANCE_SELF=$(readlink -f -- "$_self" 2>/dev/null || printf '%s\n' "$_self")
export SEVERANCE_SELF
_bindir=${SEVERANCE_SELF%/*}
LIBEXEC=$_bindir/../libexec
SEVERANCE_SHARE=${SEVERANCE_SHARE:-$_bindir/../share}
export SEVERANCE_SHARE

[ -r "$LIBEXEC/common.sh" ] ||
  { echo "severance: libexec not found at $LIBEXEC" >&2; exit 1; }
. "$LIBEXEC/common.sh"

_usage() {
  cat >&2 <<'EOF'
usage: severance <command> [args]
  install | uninstall        standalone: (un)link into ~/.local. Links ONLY;
                             it configures no other tool
  list                       provisioned profiles (* marks the default)
  show   [profile]           the resolved settings, as a human report
  use    <profile>|--clear   set (or clear) the default-profile marker
  current [PID]              which enclave a process is IN (profile name, or
                             nothing); non-zero only if it cannot tell
  init   <name> [key=val..]  scaffold a new profile record
  seal   [profile...]        provision the work boundary (privileged)
  runner [profile...]        provision the rootless-docker runner (privileged)
  forget <profile> [--purge] decommission: tear down the runner (--purge also
                             removes the record; the tree stays sealed)
  check  [--seal|--runner]   audit; non-zero on drift (bare = both + validate)
  validate [profile]         lint profile records (before they provision)
  doctor                     whole-boundary health (install + wall + runner)
  guard                      ZDR refuse: exit 1 inside a work tree without
                             the enclave group

machine interface -- the STABLE contracts, consumed by other tools. Their
output shape and exit codes do not change silently: a change to either is a
BREAKING change, recorded in docs/breaking-changes.md, and the retired
spelling fails loud rather than being quietly aliased:
  current [PID]              exit 0 = answered (one word, or nothing when the
                             process is in no enclave); exit 2 = could NOT
                             answer (bad pid, or no such process)
  guard                      exit 0 ok / 1 refuse. Message on stderr.
There is deliberately nothing else. `show` is a human report, not a contract.
EOF
  exit 2
}

cmd=${1:-}
[ "$#" -gt 0 ] && shift
case $cmd in
  install)   . "$LIBEXEC/install.sh"; sev_install "$@" ;;
  uninstall) . "$LIBEXEC/install.sh"; sev_uninstall "$@" ;;
  list)    . "$LIBEXEC/profile.sh"; sev_list "$@" ;;
  show)    . "$LIBEXEC/profile.sh"; sev_show "$@" ;;
  use)     . "$LIBEXEC/profile.sh"; sev_use "$@" ;;
  current) . "$LIBEXEC/profile.sh"; sev_current "$@" ;;
  init)    . "$LIBEXEC/profile.sh"; sev_init "$@" ;;
  seal)    sev_sudo_prime; . "$LIBEXEC/seal.sh";   sev_seal "$@" ;;
  runner)  sev_sudo_prime; . "$LIBEXEC/runner.sh"; sev_runner "$@" ;;
  forget)  . "$LIBEXEC/forget.sh"; sev_forget "$@" ;;
  check)    . "$LIBEXEC/check.sh"; sev_check "$@" ;;
  validate) . "$LIBEXEC/validate.sh"; sev_validate "$@" ;;
  doctor)   . "$LIBEXEC/doctor.sh"; sev_doctor "$@" ;;
  guard)    . "$LIBEXEC/guard.sh"; sev_guard "$@" ;;
  # `context resolve|guard` was a CONSUMER's vocabulary on severance's binary:
  # two questions welded together because one integration asked them that way.
  # resolve retired into `current`; guard is a top-level verb. Kept as a loud
  # error, not a silent alias: a stale caller must be FIXED, not quietly served
  # by a shim that hides which spelling is live.
  #
  # Exit 1, NOT the conventional 2 for a usage error, because 2 is already
  # spoken for in the guard contract this verb used to serve: a veto seam that
  # reads 2 as "warn, then PROCEED" and anything else as "refuse". A retired
  # boundary verb must fail CLOSED. Exiting 2 here turned a stale hook into a
  # silently disabled ZDR guard, which is the precise failure this whole verb
  # exists to prevent.
  context)
    echo "severance: 'context' is retired." >&2
    echo "  context resolve -> severance current (prints nothing, not" >&2
    echo "                     'personal', when outside an enclave)" >&2
    echo "  context guard   -> severance guard" >&2
    exit 1 ;;
  ''|-h|--help|help) _usage ;;
  *) echo "severance: unknown command: $cmd" >&2; _usage ;;
esac
