#!/bin/sh
# work - enter a work PROFILE (enclave), or run one command in it.
#
#   work                        enter the sole (or default) enclave.
#   work enter [profile]        enter, naming the enclave explicitly.
#   work run [profile] -- CMD   run one command in that enclave and exit with
#                               its status.
#
# The verb and the profile are BOTH omittable: bare `work` is `work enter`, and
# the profile may be left out when exactly one is provisioned or a default
# marker is set (with several and no default, it is REQUIRED and work fails
# loud rather than guessing a group).
#
# No argument is ever GUESSED. The verb set is closed, the profile sits in a
# fixed slot, and `--` ends work's own arguments, so nothing can be a profile
# or a command by accident. (It used to take arg1 as the profile only when it
# happened to name one, which meant an unrecognised word fell through to the
# sudo re-exec and HUNG with no TTY.)
#
# work is the "go do" tool: the ONE privileged action, a human sudo prompt and
# a session. It answers no questions. "Which enclave is this process in" is
# `severance current`, on the config/admin/query binary, so a consumer needs to
# know about one command rather than two.
#
# A subshell with an added group + env; nothing persists. Reads the severance
# profiles via work-context.sh. Sole sudo entry point for the boundary.
set -eu

self=$(command -v -- "$0" 2>/dev/null || printf '%s\n' "$0")

# Locate the work-context reader. severance ships it beside us at
# ../libexec/severance/work-context.sh (resolve our real path through any
# install symlink to find it); fall back to the installed and the legacy paths
# so a standalone box, a host-managed box, and a mid-transition box all resolve.
_real=$(readlink -f -- "$self" 2>/dev/null || printf '%s\n' "$self")
wc_lib=
for _cand in \
  "${SEVERANCE_LIB:-}" \
  "${_real%/*}/../libexec/work-context.sh" \
  "$HOME/.local/libexec/severance/work-context.sh" \
  "$HOME/lib/work/work-context.sh"; do
  if [ -n "$_cand" ] && [ -r "$_cand" ]; then wc_lib=$_cand; break; fi
done
[ -n "$wc_lib" ] ||
  { echo "work: work-context reader not found" >&2; exit 1; }
. "$wc_lib"

# --- argument grammar: [verb] [profile] [-- CMD ...] -------------------------
# Parsed into: $mode (enter|run), $prof (may be empty), and $@ (the command,
# for run). Nothing is guessed. On a re-exec the profile is already resolved and
# forwarded in WORK_PROFILE, and we re-parse a NORMALISED argv that this script
# built itself, so the grammar is applied exactly once per invocation.
usage() {
  echo "usage: work [enter [profile]]" >&2
  echo "       work run [profile] -- CMD ..." >&2
  exit 2
}

mode=enter
prof=
if [ "${WORK_REEXEC:-}" = 1 ]; then prof=${WORK_PROFILE:-}; fi

case "${1:-}" in
  enter)
    shift
    # An optional profile, and nothing else. A stray word here is an error
    # rather than a command, which is the whole point of the closed verb set.
    if [ "$#" -gt 0 ]; then
      case $1 in --|-*) usage ;; esac
      prof=$1; shift
    fi
    [ "$#" -eq 0 ] || usage
    ;;
  run)
    mode=run
    shift
    # The profile slot is positional and ends at `--`, which is MANDATORY for
    # run: without it, `work run npm test` would need a name lookup to know
    # whether `npm` is a profile, and that guess is what this grammar removes.
    if [ "${1:-}" != -- ]; then
      [ "$#" -gt 0 ] || usage
      case $1 in -*) usage ;; esac
      prof=$1; shift
    fi
    [ "${1:-}" = -- ] || usage
    shift
    [ "$#" -gt 0 ] || usage
    ;;
  '') ;;                                  # bare `work` = `work enter`
  *) usage ;;
esac

_rc=0; wc_load "$prof" || _rc=$?
if [ "$_rc" != 0 ]; then
  [ "$_rc" = 1 ] && echo "work: no work profile provisioned" >&2
  exit 1
fi

# Prompt label. Sourced from the work-context so it can't drift; change it here
# only if you want the prompt to read differently from the context name.
LABEL=${WC_LABEL:-work}

# Acquire the group once via a same-uid sudo, then re-enter. sudo scrubs the
# environment, so forward the live session resources env_load cannot
# reconstruct: SSH_AUTH_SOCK, and the Wayland/X display + runtime dir so an app
# in here (e.g. claude) can still reach the system clipboard to PASTE (copy out
# is an OSC 52 escape and needs none of this). Same uid, so this crosses no
# boundary -- the wall is the group ACL on work_dir, untouched. Everything else
# is re-derived by env_load. WORK_REEXEC guards against a loop with no sudoers.
#
# The re-exec forwards a NORMALISED argv (`run -- CMD`, or `enter`), never the
# user's original words: the profile is already resolved and travels in
# WORK_PROFILE, so re-parsing cannot reach a different answer than this pass
# did. Membership is asked through the reader's wc_group_rank, the same
# implementation `severance current` uses, so entry and query cannot drift.
_rank=0; wc_group_rank || _rank=$?
if [ "$_rank" = 2 ]; then
  if [ "${WORK_REEXEC:-}" = 1 ]; then
    echo "work: could not acquire '$WC_GROUP' group (check sudoers)" >&2
    exit 1
  fi
  if [ "$mode" = run ]; then set -- run -- "$@"; else set -- enter; fi
  exec sudo -u "$(id -un)" -g "$WC_GROUP" env WORK_REEXEC=1 \
    WORK_PROFILE="$WC_PROFILE" \
    ${SSH_AUTH_SOCK:+SSH_AUTH_SOCK="$SSH_AUTH_SOCK"} \
    ${WAYLAND_DISPLAY:+WAYLAND_DISPLAY="$WAYLAND_DISPLAY"} \
    ${XDG_RUNTIME_DIR:+XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"} \
    ${DISPLAY:+DISPLAY="$DISPLAY"} \
    "$self" "$@"
fi

# The re-exec handshake is done here (group acquired, profile resolved above).
# WORK_REEXEC was EXPORTED into this process; unset it so it does NOT leak to
# children. Otherwise a nested `work run ...` from inside the session sees
# WORK_REEXEC=1 and takes the "profile already resolved" branch, pinning the
# nested call to the OUTER enclave. WORK_PROFILE is KEPT -- it is real session
# state (wc_load reads it as the current enclave for a bare `work`); only the
# re-exec flag must not survive.
unset WORK_REEXEC

export CLAUDE_CONFIG_DIR="$WC_CLAUDE_CONFIG"
export WORK_CONTEXT="$LABEL"
unset ANTHROPIC_API_KEY

# WORK_HOME: the sealed enclave root (= work_dir). Point every work-scoped tool
# at its dir UNDER it, so all work credential stores live behind the ONE gate
# (docs/work-home.md). These are EXPLICIT, per-tool overrides ONLY -- we do NOT
# set HOME or XDG_CONFIG_HOME (never hijack an implicitly-resolved var; that
# would silently over-capture personal config). CLAUDE_CONFIG_DIR above is the
# derived WC_CLAUDE_CONFIG ($WC_CONFIG_ROOT/claude). The valet-key pool root is
# the load-bearing one: it puts every work agent's credential slots inside the
# seal. GEMINI_CLI_HOME/CODEX_HOME name the per-tool base (valet-key overrides
# them per slot at launch); a bare invocation falls back to the base.
export WORK_HOME="$WC_DIR"
export VALET_KEY_POOL_ROOT="$WC_CONFIG_ROOT/valet-key-pool"
export GEMINI_CLI_HOME="$WC_CONFIG_ROOT/gemini"   # gemini appends /.gemini
export CODEX_HOME="$WC_CONFIG_ROOT/codex"

# Point docker at THIS enclave's rootless-docker runner socket (the runner:
# /run/<runner>/docker.sock, group <group> 0660 -- a work session reaches it by
# group, a personal process gets EACCES). Without this, `docker` in a work
# session falls to the default socket (the masked system daemon) and fails
# "permission denied" -- which is what breaks testcontainers/e2e. Set for BOTH
# the command and interactive forms below; harmless if the runner is not up yet
# (docker then fails "cannot connect", which the runner check flags).
[ -n "$WC_RUNNER" ] && export DOCKER_HOST="unix:///run/$WC_RUNNER/docker.sock"

# `run`: one command in context, exiting with its status. Unset any inherited
# $ENV so it cannot leak into the command's children (it collides with apps that
# read ENV as a config var), then source the enclave rc so `work run` gets the
# same work-tree env as the interactive shell below. Keyed on $mode, not on
# $#: the grammar already decided, and re-deciding from argv here is how the
# two could disagree.
if [ "$mode" = run ]; then
  cd "$WC_DIR" 2>/dev/null || true
  unset ENV
  # Establish the box shell environment (PATH + self/env, and the nvm/tfenv
  # toolchains on PATH) so `work run` runs with the SAME tools as the
  # interactive shell -- node/npm/terraform etc. Without it a re-exec'd command
  # ran with only sudo's bare PATH and no nvm (`node: command not found`).
  # GOTCHA: dash's `.` DROPS arguments (POSIX-permitted), so `. file a b` lets
  # the SOURCED file see the CALLER's $@ (here: the command) as its scope, not
  # `path env nvm tfenv`. Wrap the source in a function so the file sees the
  # FUNCTION's params, and the script's own $@ stays intact for `exec "$@"`.
  # (~/.profile's bare `. ... args` works only because a login shell has no $@;
  # the interactive rc below is sourced by ksh, which -- unlike dash -- honors
  # `.` args.)
  if [ -r "$HOME/lib/load_helper_funcs" ]; then
    _load_helpers() { . "$HOME/lib/load_helper_funcs"; }
    set +eu; _load_helpers path env nvm tfenv; set -eu
    # Fail LOUD, not silent: a load that leaves env_load undefined is incoherent
    # and would otherwise degrade to a bare PATH that fails later and elsewhere.
    command -v env_load >/dev/null 2>&1 \
      || { echo "work: box shell env failed to load" >&2; exit 1; }
    set +eu; env_load; set -eu
  fi
  if [ -r "$WC_DIR/.workrc" ]; then set +eu; . "$WC_DIR/.workrc"; set -eu; fi
  exec "$@"
fi

# Interactive: point $ENV at a throwaway rc that establishes the environment
# (env_load, shared with login shells), turns on history, and sets the fixed
# prompt. Every POSIX shell sources $ENV interactively, so no per-shell case.
# Not exec'd, so the trap cleans up the rc.
cd "$WC_DIR" 2>/dev/null || cd "$HOME"
rc=$(mktemp "${TMPDIR:-/tmp}/work-rc.XXXXXX")
trap 'rm -f "$rc"' EXIT INT TERM
# The block emits LITERAL shell into the rc; $-expressions are meant to stay
# unexpanded until the rc is sourced, so single quotes are correct here.
# shellcheck disable=SC2016
{
  echo '. "$HOME/lib/load_helper_funcs" path env sh_history nvm tfenv'
  echo 'env_load'
  echo 'sh_history_start'
  printf "PS1='[%s]\$ '\n" "$LABEL"
  # $ENV was only the bootstrap path to this rc; unset it so it does not leak
  # into children (it collides with apps that read ENV as a config var, e.g.
  # dotenv/Next), then source the enclave's own rc LAST so it can re-set ENV.
  echo 'unset ENV'
  printf '[ -r "%s/.workrc" ] && . "%s/.workrc"\n' "$WC_DIR" "$WC_DIR"
} > "$rc"
echo "work: $LABEL context (group=$WC_GROUP account=$WC_CLAUDE_CONFIG)" >&2
echo "work: type 'exit' to leave." >&2
ENV="$rc" "${SHELL:-/bin/sh}" -i
